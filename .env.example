# Copy to .env for local development. Production values belong in the
# deployment secret directory and a private env file, never in Git.
COMPOSE_PROJECT_NAME=isp-network-tools
APP_ENV=development
LOG_LEVEL=INFO

# Existing Nginx Proxy Manager Docker network. Do not create another NPM.
PROXY_NETWORK=npm_default
ADMIN_BASE_URL=http://admin-center.localhost
PUBLIC_BASE_URL=http://geofeed.localhost
HEALTH_BASE_URL=http://network-health.localhost
TRUSTED_HOSTS=admin-center.localhost,localhost,127.0.0.1
HEALTH_TRUSTED_HOSTS=network-health.localhost,localhost,127.0.0.1

# PostgreSQL is one cluster with isolated databases and roles.
POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_USER=isp_network_tools
POSTGRES_DB=isp_core
CORE_DB_USER=isp_core
GEOFEED_DB_USER=geofeed
HEALTH_DB_USER=isp_network_health

# Redis is internal only.
REDIS_IMAGE=redis:7.4-alpine
# Optional operational guard for very large CIDR/ASN scans. Keep 0 only when
# the deployment has an external resource policy for scan workers.
INH_MAX_CIDR_IPS=0
HEALTH_WORKER_MAX_WORKERS=32

# Optional identity providers. Local auth remains available for bootstrap.
LOCAL_AUTH_ENABLED=true
DEV_AUTH=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
GOOGLE_CLIENT_ID=
GRAPH_PHOTO_ENABLED=false

# White-label defaults. Change these before production.
SUITE_NAME=ISP Network Tools
COMPANY_NAME=Sua empresa
TOTP_ISSUER=ISP Network Tools
SMTP_FROM=
PUBLIC_CONTACT_EMAIL=noc@example.invalid

# Local secret files generated by scripts/bootstrap-secrets.sh.
SECRETS_DIR=./.local/secrets
